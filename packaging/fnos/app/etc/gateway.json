{
  "app_dir": "@APP_DIR@",
  "state_dir": "@STATE_DIR@",
  "run_dir": "@RUN_DIR@",
  "prefix": "/app/tuios",
  "gateway_account": "tuios",
  "trusted_gateway_accounts": ["root"],
  "allowed_hosts": [],
  "allowed_origins": [],
  "allow_same_origin_fetch": true,
  "gateway_grant_lifetime_seconds": 30,
  "gateway_grant_capacity": 512,
  "gateway_grant_per_user": 8,
  "external_origin_ports": {"http": [5666], "https": [5667]},
  "max_users": 8,
  "max_connections_per_user": 4,
  "connection_lifetime_seconds": 3600,
  "startup_timeout_seconds": 30,
  "shutdown_timeout_seconds": 60,
  "state_restore_max_entries": 100000,
  "state_restore_max_depth": 64,
  "user_path": "/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
  "language": "C.UTF-8",
  "terminal_shell": "/bin/bash"
}
